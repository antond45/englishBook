    "11C": {
      "theory": [
        {
          "title": "Present Continuous — то, что происходит сейчас",
          "text": "am / is / are + глагол-ing. Используем для действий в момент речи.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I'm reading. She's cooking. They're playing."
              ],
              [
                "−",
                "I'm not working. He isn't sleeping."
              ],
              [
                "?",
                "Are you listening? What are you doing?"
              ]
            ]
          },
          "examples": [
            {
              "en": "Look! It's raining.",
              "ru": "Смотри! Идёт дождь."
            },
            {
              "en": "Shh! The baby is sleeping.",
              "ru": "Тише! Ребёнок спит."
            }
          ]
        },
        {
          "title": "Present Simple или Present Continuous?",
          "table": {
            "head": [
              "Present Simple",
              "Present Continuous"
            ],
            "rows": [
              [
                "обычно, регулярно",
                "прямо сейчас"
              ],
              [
                "I work every day.",
                "I'm working now."
              ],
              [
                "She usually drinks tea.",
                "Today she's drinking coffee."
              ]
            ]
          },
          "tip": "Подсказки: now, at the moment, Look!, Listen! → Continuous; every day, usually, often → Simple."
        }
      ],
      "videos": [
        {
          "title": "Present continuous for beginners",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=present+continuous+for+beginners+english"
