    "11B": {
      "theory": [
        {
          "title": "Вопросы с be going to",
          "examples": [
            {
              "en": "Are you going to stay at home? — Yes, I am. / No, I'm not.",
              "ru": "Ты собираешься остаться дома?"
            },
            {
              "en": "Is she going to come? — Yes, she is. / No, she isn't.",
              "ru": "Она собирается прийти?"
            },
            {
              "en": "What are you going to do tomorrow?",
              "ru": "Что ты собираешься делать завтра?"
            },
            {
              "en": "Where are they going to stay?",
              "ru": "Где они собираются остановиться?"
            }
          ],
          "tip": "Порядок как в вопросах с be: вопросительное слово → am/is/are → подлежащее → going to → глагол."
        }
      ],
