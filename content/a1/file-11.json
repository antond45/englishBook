{
  "fileId": "11",
  "lessons": {
    "11A": {
      "theory": [
        {
          "title": "be going to — планы",
          "text": "be going to + глагол — так говорят о том, что уже решили сделать в будущем (план, намерение).",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I'm going to learn Spanish. / She's going to buy a car."
              ],
              [
                "−",
                "I'm not going to watch TV. / They aren't going to come."
              ],
              [
                "?",
                "Are you going to stay? / Is he going to call?"
              ]
            ]
          },
          "examples": [
            {
              "en": "We're going to visit our parents next weekend.",
              "ru": "В следующие выходные мы собираемся навестить родителей."
            }
          ],
          "tip": "Не забывай be: I'm going to… (не I going to…). А после to — глагол в начальной форме."
        },
        {
          "title": "Слова будущего времени",
          "text": "tonight (сегодня вечером), tomorrow (завтра), next week / month / year (на следующей неделе / в следующем месяце / году), in two days (через два дня), soon (скоро)."
        }
      ],
      "videos": [
        {
          "title": "Be going to for future plans",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=be+going+to+future+plans+beginners"
        }
      ],
