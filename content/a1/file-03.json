    "3B": {
      "theory": [
        {
          "title": "Притяжательный 's",
          "text": "Чтобы сказать «чей-то», к имени или существительному добавляем 's. Порядок обратный русскому: «брат Анны» — Anna's brother (сначала владелец).",
          "examples": [
            {
              "en": "Anna's brother",
              "ru": "брат Анны"
            },
            {
              "en": "my father's car",
              "ru": "машина моего отца"
            },
            {
              "en": "the teacher's book",
              "ru": "книга учителя"
            }
          ],
          "tip": "Если слово во множественном числе уже на -s, ставим только апостроф: my parents' house — дом моих родителей."
        },
        {
          "title": "'s — три значения",
          "table": {
            "head": [
              "Пример",
              "Значение"
            ],
            "rows": [
              [
                "She's my cousin.",
                "'s = is"
              ],
              [
                "Jack's car is red.",
                "'s = чей (принадлежность)"
              ],
              [
                "What's your name?",
                "'s = is"
              ]
            ]
          }
        },
        {
          "title": "Ещё родственники",
          "examples": [
            {
              "en": "aunt / uncle",
              "ru": "тётя / дядя"
            },
            {
              "en": "cousin",
              "ru": "двоюродный брат / сестра"
            },
            {
              "en": "niece / nephew",
              "ru": "племянница / племянник"
            }
          ]
        }
      ],
