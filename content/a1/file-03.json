  "lessons": {
    "3A": {
      "theory": [
        {
          "title": "Притяжательные прилагательные",
          "text": "Они отвечают на вопрос «чей?» и всегда стоят перед существительным. Русское «свой» переводится по смыслу: «Она любит свою маму» — She loves her mum.",
          "table": {
            "head": [
              "Местоимение",
              "Чей?",
              "Пример"
            ],
            "rows": [
              [
                "I",
                "my — мой",
                "my brother"
              ],
              [
                "you",
                "your — твой, ваш",
                "your phone"
              ],
              [
                "he",
                "his — его",
                "his car"
              ],
              [
                "she",
                "her — её",
                "her sister"
              ],
              [
                "it",
                "its — его/её (о предмете)",
                "its name"
              ],
              [
                "we",
                "our — наш",
                "our house"
              ],
              [
                "they",
                "their — их",
                "their children"
              ]
            ]
          },
          "examples": [
            {
              "en": "Tom and his wife.",
              "ru": "Том и его жена."
            },
            {
              "en": "Anna and her husband.",
              "ru": "Анна и её муж."
            }
          ],
          "tip": "its (без апострофа) значит «его», а it's = it is. Это частая ошибка даже у носителей языка."
        },
        {
          "title": "Семья",
          "examples": [
            {
              "en": "mother / father — parents",
              "ru": "мама / папа — родители"
            },
            {
              "en": "brother / sister",
              "ru": "брат / сестра"
            },
            {
              "en": "son / daughter — children",
              "ru": "сын / дочь — дети"
            },
            {
              "en": "husband / wife",
              "ru": "муж / жена"
            },
            {
              "en": "grandmother / grandfather",
              "ru": "бабушка / дедушка"
            }
          ]
        }
      ],
      "videos": [
        {
          "title": "Family members in English",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=family+members+vocabulary+english+beginners"
