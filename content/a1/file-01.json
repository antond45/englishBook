  "lessons": {
    "1A": {
      "theory": [
        {
          "title": "Глагол be: I am, you are",
          "text": "В русском языке «я студент» обходится без глагола. В английском глагол be (быть) обязателен: I am a student — дословно «я есть студент». Его нельзя пропускать.",
          "table": {
            "head": [
              "Полная форма",
              "Краткая форма",
              "Перевод"
            ],
            "rows": [
              [
                "I am",
                "I'm",
                "я (есть)"
              ],
              [
                "you are",
                "you're",
                "ты / вы (есть)"
              ]
            ]
          },
          "examples": [
            {
              "en": "I'm Anna.",
              "ru": "Я Анна."
            },
            {
              "en": "You're in room five.",
              "ru": "Ты в комнате пять."
            },
            {
              "en": "I'm from Russia.",
              "ru": "Я из России."
            }
          ],
          "tip": "В разговоре почти всегда говорят краткие формы: I'm, you're. Полную форму I am используют для акцента или в официальном тексте."
        },
        {
          "title": "Приветствия",
          "examples": [
            {
              "en": "Hello! / Hi!",
              "ru": "Здравствуйте! / Привет!"
            },
            {
              "en": "How are you? — Fine, thanks. And you?",
              "ru": "Как дела? — Хорошо, спасибо. А у тебя?"
            },
            {
              "en": "Nice to meet you.",
              "ru": "Приятно познакомиться."
            },
            {
              "en": "Goodbye! / Bye! See you tomorrow.",
              "ru": "До свидания! / Пока! До завтра."
            }
          ]
        },
        {
          "title": "Числа 0–20",
          "text": "0 zero, 1 one, 2 two, 3 three, 4 four, 5 five, 6 six, 7 seven, 8 eight, 9 nine, 10 ten, 11 eleven, 12 twelve, 13 thirteen, 14 fourteen, 15 fifteen, 16 sixteen, 17 seventeen, 18 eighteen, 19 nineteen, 20 twenty.",
          "tip": "13–19 заканчиваются на -teen, и ударение падает на него: thir-TEEN. Это помогает не путать 13 (thirteen) и 30 (THIR-ty)."
        }
      ],
