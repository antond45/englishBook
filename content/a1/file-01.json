    "1C": {
      "theory": [
        {
          "title": "Отрицание с be",
          "text": "Чтобы сказать «не», ставим not после am / is / are. В разговоре — краткие формы.",
          "table": {
            "head": [
              "+",
              "−",
              "Краткое −"
            ],
            "rows": [
              [
                "I am",
                "I am not",
                "I'm not"
              ],
              [
                "you are",
                "you are not",
                "you aren't / you're not"
              ],
              [
                "he / she / it is",
                "he is not",
                "he isn't / he's not"
              ]
            ]
          },
          "examples": [
            {
              "en": "I'm not Spanish.",
              "ru": "Я не испанец."
            },
            {
              "en": "It isn't a pen. It's a pencil.",
              "ru": "Это не ручка. Это карандаш."
            }
          ],
          "tip": "Формы amn't не существует. Говорят только I'm not."
        },
        {
          "title": "Вопросы с be",
          "text": "В вопросе am / is / are ставится перед подлежащим. Отвечают кратко, повторяя be.",
          "examples": [
            {
              "en": "Are you a student? — Yes, I am. / No, I'm not.",
              "ru": "Ты студент? — Да. / Нет."
            },
            {
              "en": "Is it a book? — Yes, it is. / No, it isn't.",
              "ru": "Это книга? — Да. / Нет."
            }
          ],
          "tip": "В кратком положительном ответе сокращать нельзя: Yes, I am (а не Yes, I'm)."
        },
        {
          "title": "a или an?",
          "text": "Перед существительным в единственном числе нужен артикль. a ставится перед согласным звуком, an — перед гласным звуком.",
          "examples": [
            {
              "en": "a book, a pen, a chair",
              "ru": "согласный звук"
            },
            {
              "en": "an umbrella, an apple, an English book",
              "ru": "гласный звук"
            }
          ],
          "tip": "Важен звук, а не буква: an hour (h не читается), но a university (звучит как «ю»)."
        }
      ],
