    "1B": {
      "theory": [
        {
          "title": "Глагол be: he, she, it",
          "text": "Для одного человека или предмета используется is. he — он (мужчина), she — она (женщина), it — оно (предмет, животное, страна, город).",
          "table": {
            "head": [
              "Полная форма",
              "Краткая форма"
            ],
            "rows": [
              [
                "he is",
                "he's"
              ],
              [
                "she is",
                "she's"
              ],
              [
                "it is",
                "it's"
              ]
            ]
          },
          "examples": [
            {
              "en": "He's from Italy.",
              "ru": "Он из Италии."
            },
            {
              "en": "She's Japanese.",
              "ru": "Она японка."
            },
            {
              "en": "It's a Chinese car.",
              "ru": "Это китайская машина."
            },
            {
              "en": "Paris is in France.",
              "ru": "Париж находится во Франции."
            }
          ],
          "tip": "Предметы — это it, даже если по-русски они «он» или «она»: машина, город и стол в английском всегда it."
        },
        {
          "title": "Страны и национальности",
          "text": "Национальности часто образуются окончаниями -ish, -an или -ese. Названия стран и национальностей всегда пишутся с большой буквы.",
          "table": {
            "head": [
              "Страна",
              "Национальность"
            ],
            "rows": [
              [
                "Spain, England, Turkey",
                "Spanish, English, Turkish"
              ],
              [
                "Russia, Italy, Brazil",
                "Russian, Italian, Brazilian"
              ],
              [
                "Japan, China",
                "Japanese, Chinese"
              ],
              [
                "France, Greece",
                "French, Greek"
              ]
            ]
          },
          "examples": [
            {
              "en": "Where are you from? — I'm from Russia. I'm Russian.",
              "ru": "Откуда ты? — Я из России. Я русский."
            }
          ]
        }
      ],
