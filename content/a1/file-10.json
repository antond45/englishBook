  "lessons": {
    "10A": {
      "theory": [
        {
          "title": "Past Simple: неправильные глаголы",
          "text": "У многих частых глаголов прошедшая форма не по правилу -ed. Их нужно выучить — зато их не так много, и они постоянно встречаются.",
          "table": {
            "head": [
              "Глагол",
              "Past Simple",
              "Перевод"
            ],
            "rows": [
              [
                "go",
                "went",
                "идти, ехать"
              ],
              [
                "have",
                "had",
                "иметь"
              ],
              [
                "get",
                "got",
                "получать, добираться"
              ],
              [
                "see",
                "saw",
                "видеть"
              ],
              [
                "buy",
                "bought",
                "покупать"
              ],
              [
                "eat",
                "ate",
                "есть"
              ],
              [
                "take",
                "took",
                "брать"
              ],
              [
                "meet",
                "met",
                "встречать"
              ],
              [
                "come",
                "came",
                "приходить"
              ],
              [
                "do",
                "did",
                "делать"
              ]
            ]
          },
          "tip": "Неправильная форма нужна только в утверждении. В отрицании и вопросе — did + начальная форма: I went → I didn't go → Did you go?"
        }
      ],
      "videos": [
        {
          "title": "Irregular verbs in the past simple",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=irregular+verbs+past+simple+for+beginners"
        }
      ],
