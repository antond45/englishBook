    "10B": {
      "theory": [
        {
          "title": "Вопросы о прошлом с вопросительными словами",
          "text": "Схема: вопросительное слово + did + подлежащее + глагол в начальной форме?",
          "examples": [
            {
              "en": "Where did you go?",
              "ru": "Куда вы ездили?"
            },
            {
              "en": "How did you get there?",
              "ru": "Как вы туда добрались?"
            },
            {
              "en": "Where did you stay?",
              "ru": "Где вы остановились?"
            },
            {
              "en": "What did you do?",
              "ru": "Что вы делали?"
            },
            {
              "en": "What was the weather like?",
              "ru": "Какая была погода? (с was, без did!)"
            }
          ],
          "tip": "С глаголом be did не нужен: Where were you? Was it good?"
        },
        {
          "title": "Транспорт",
          "text": "by car, by bus, by train, by plane, by bike — на машине, автобусе и т.д. Но: on foot — пешком. Глаголы: drive (drove), fly (flew), take a bus/taxi."
        }
      ],
