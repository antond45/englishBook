    "6C": {
      "theory": [
        {
          "title": "like / love / hate + -ing",
          "text": "Чтобы рассказать, что тебе нравится делать, после like, love, hate, enjoy, don't mind используй глагол с окончанием -ing.",
          "table": {
            "head": [
              "Глагол",
              "Значение"
            ],
            "rows": [
              [
                "love",
                "очень люблю ❤❤"
              ],
              [
                "like / enjoy",
                "нравится ❤"
              ],
              [
                "don't mind",
                "не против 😐"
              ],
              [
                "don't like",
                "не нравится"
              ],
              [
                "hate",
                "ненавижу"
              ]
            ]
          },
          "examples": [
            {
              "en": "I love dancing.",
              "ru": "Обожаю танцевать."
            },
            {
              "en": "She hates getting up early.",
              "ru": "Она терпеть не может рано вставать."
            }
          ]
        },
        {
          "title": "Правописание -ing",
          "table": {
            "head": [
              "Правило",
              "Пример"
            ],
            "rows": [
              [
                "обычно + ing",
                "read → reading, play → playing"
              ],
              [
                "немая -e уходит",
                "dance → dancing, write → writing"
              ],
              [
                "короткий глагол: гласная + согласная → удвоение",
                "swim → swimming, run → running, shop → shopping"
              ]
            ]
          }
        }
      ],
