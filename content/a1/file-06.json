    "6B": {
      "theory": [
        {
          "title": "Просьбы и разрешение",
          "text": "Can I…? — просим разрешения что-то сделать. Can you…? — просим другого человека что-то сделать. Добавляй please — это важно для вежливости.",
          "examples": [
            {
              "en": "Can I open the window?",
              "ru": "Можно я открою окно?"
            },
            {
              "en": "Can you help me, please?",
              "ru": "Можешь мне помочь, пожалуйста?"
            },
            {
              "en": "Could you repeat that, please?",
              "ru": "Не могли бы вы повторить? (вежливее)"
            }
          ]
        },
        {
          "title": "Как ответить",
          "table": {
            "head": [
              "Да",
              "Нет"
            ],
            "rows": [
              [
                "Yes, of course.",
                "Sorry, you can't."
              ],
              [
                "Sure.",
                "I'm afraid not."
              ],
              [
                "No problem.",
                "Sorry, I can't. I'm busy."
              ]
            ]
          }
        }
      ],
