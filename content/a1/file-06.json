  "lessons": {
    "6A": {
      "theory": [
        {
          "title": "can / can't — умение",
          "text": "can (могу, умею) — модальный глагол. После него идёт глагол без to, и can не меняется по лицам.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I can swim. / She can swim."
              ],
              [
                "−",
                "He can't (cannot) drive."
              ],
              [
                "?",
                "Can you cook?"
              ],
              [
                "Ответ",
                "Yes, I can. / No, I can't."
              ]
            ]
          },
          "examples": [
            {
              "en": "I can speak three languages.",
              "ru": "Я говорю на трёх языках."
            },
            {
              "en": "My son can't ride a bike.",
              "ru": "Мой сын не умеет кататься на велосипеде."
            }
          ],
          "tip": "Нельзя: She cans, I can to swim, Do you can…? Правильно: She can, I can swim, Can you…?"
        },
        {
          "title": "Произношение",
          "text": "В утверждении can произносится слабо, как /kən/: I /kən/ swim. А can't всегда ударное и долгое: I /kɑːnt/ swim. По ударению можно понять, «да» это или «нет»."
        }
      ],
      "videos": [
        {
          "title": "Can and can't for ability",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=can+can't+ability+english+beginners"
        }
      ],
