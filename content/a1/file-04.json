    "4B": {
      "theory": [
        {
          "title": "Вопросы в Present Simple",
          "text": "Вопрос строится с помощью do. Порядок: (вопросительное слово) + do + подлежащее + глагол.",
          "table": {
            "head": [
              "Вопрос",
              "Краткий ответ"
            ],
            "rows": [
              [
                "Do you like coffee?",
                "Yes, I do. / No, I don't."
              ],
              [
                "Do they live here?",
                "Yes, they do. / No, they don't."
              ]
            ]
          },
          "examples": [
            {
              "en": "Where do you live?",
              "ru": "Где ты живёшь?"
            },
            {
              "en": "What do you have for breakfast?",
              "ru": "Что ты ешь на завтрак?"
            }
          ],
          "tip": "В кратком ответе не повторяем основной глагол: Yes, I do (а не Yes, I like)."
        },
        {
          "title": "Еда и напитки",
          "examples": [
            {
              "en": "breakfast / lunch / dinner",
              "ru": "завтрак / обед / ужин"
            },
            {
              "en": "bread, cheese, eggs, fruit, vegetables",
              "ru": "хлеб, сыр, яйца, фрукты, овощи"
            },
            {
              "en": "tea, coffee, juice, water, milk",
              "ru": "чай, кофе, сок, вода, молоко"
            }
          ]
        }
      ],
