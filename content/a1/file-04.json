  "lessons": {
    "4A": {
      "theory": [
        {
          "title": "Present Simple: когда используем",
          "text": "Present Simple (настоящее простое) описывает то, что верно всегда, или то, что происходит регулярно: где живёшь, где работаешь, что любишь.",
          "examples": [
            {
              "en": "I live in a flat.",
              "ru": "Я живу в квартире."
            },
            {
              "en": "We work in an office.",
              "ru": "Мы работаем в офисе."
            },
            {
              "en": "They like pizza.",
              "ru": "Они любят пиццу."
            }
          ]
        },
        {
          "title": "Утверждение и отрицание (I, you, we, they)",
          "text": "С I, you, we, they глагол стоит в начальной форме. Для отрицания нужен вспомогательный глагол do + not = don't.",
          "table": {
            "head": [
              "+",
              "−"
            ],
            "rows": [
              [
                "I work",
                "I don't work"
              ],
              [
                "you live",
                "you don't live"
              ],
              [
                "we have",
                "we don't have"
              ],
              [
                "they eat",
                "they don't eat"
              ]
            ]
          },
          "tip": "Нельзя сказать I not work или I no work. Только I don't work."
        }
      ],
      "videos": [
        {
          "title": "Present simple for beginners",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=present+simple+I+you+we+they+for+beginners"
        }
      ],
      "exercises": [
