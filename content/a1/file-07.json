    "7A": {
      "theory": [
        {
          "title": "there is / there are",
          "text": "Так говорят о том, что где-то что-то есть или находится. По-русски мы начинаем с места («В кухне есть стол»), а по-английски — с there is: There's a table in the kitchen.",
          "table": {
            "head": [
              "",
              "Один предмет",
              "Несколько"
            ],
            "rows": [
              [
                "+",
                "There's a sofa.",
                "There are two chairs."
              ],
              [
                "−",
                "There isn't a garden.",
                "There aren't any shops."
              ],
              [
                "?",
                "Is there a lift?",
                "Are there any trees?"
              ],
              [
                "Ответ",
                "Yes, there is. / No, there isn't.",
                "Yes, there are. / No, there aren't."
              ]
            ]
          },
          "tip": "В отрицаниях и вопросах со множественным числом добавляем any: There aren't any plants."
        },
        {
          "title": "Дом и мебель",
          "examples": [
            {
              "en": "kitchen, living room, bedroom, bathroom, hall",
              "ru": "кухня, гостиная, спальня, ванная, прихожая"
            },
            {
              "en": "sofa, armchair, bed, wardrobe, shelf, cooker, fridge",
              "ru": "диван, кресло, кровать, шкаф, полка, плита, холодильник"
            }
          ]
        }
      ],
      "videos": [
        {
