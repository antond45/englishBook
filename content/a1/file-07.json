        {
          "title": "Объектные местоимения",
          "text": "Когда человек или предмет не делает действие, а получает его, используем объектную форму. Она стоит после глагола или предлога.",
          "table": {
            "head": [
              "Подлежащее",
              "Объект",
              "Пример"
            ],
            "rows": [
              [
                "I",
                "me",
                "Call me!"
              ],
              [
                "you",
                "you",
                "I love you."
              ],
              [
                "he",
                "him",
                "I know him."
              ],
              [
                "she",
                "her",
                "Talk to her."
              ],
              [
                "it",
                "it",
                "I like it."
              ],
              [
                "we",
                "us",
                "Help us!"
              ],
              [
                "they",
                "them",
                "I see them every day."
              ]
            ]
          },
          "tip": "После предлогов тоже объектная форма: with me, for her, to them."
        }
      ],
