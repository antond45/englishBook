    "2B": {
      "theory": [
        {
          "title": "Множественное число",
          "table": {
            "head": [
              "Правило",
              "Пример"
            ],
            "rows": [
              [
                "обычно + s",
                "a book → books, a key → keys"
              ],
              [
                "после -s, -sh, -ch, -x + es",
                "a watch → watches, a box → boxes"
              ],
              [
                "согласная + y → ies",
                "a city → cities"
              ],
              [
                "исключения",
                "a man → men, a woman → women, a child → children, a person → people"
              ]
            ]
          },
          "tip": "Слова glasses (очки), jeans, trousers всегда во множественном числе: My glasses are new."
        },
        {
          "title": "this / that / these / those",
          "table": {
            "head": [
              "",
              "Рядом",
              "Далеко"
            ],
            "rows": [
              [
                "Один предмет",
                "this (этот)",
                "that (тот)"
              ],
              [
                "Несколько",
                "these (эти)",
                "those (те)"
              ]
            ]
          },
          "examples": [
            {
              "en": "This is my phone.",
              "ru": "Это мой телефон (у меня в руке)."
