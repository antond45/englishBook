    "2A": {
      "theory": [
        {
          "title": "Глагол be во множественном числе",
          "text": "С we (мы), you (вы) и they (они) используется are. Обрати внимание: you — это и «ты», и «вы», форма всегда are.",
          "table": {
            "head": [
              "+",
              "−",
              "?"
            ],
            "rows": [
              [
                "we're (we are)",
                "we aren't",
                "Are we…?"
              ],
              [
                "you're (you are)",
                "you aren't",
                "Are you…?"
              ],
              [
                "they're (they are)",
                "they aren't",
                "Are they…?"
              ]
            ]
          },
          "examples": [
            {
              "en": "We're friends.",
              "ru": "Мы друзья."
            },
            {
              "en": "They aren't from London.",
              "ru": "Они не из Лондона."
            },
            {
              "en": "Are they students? — Yes, they are.",
              "ru": "Они студенты? — Да."
            }
          ],
          "tip": "Не путай they're (они есть), their (их) и there (там). Звучат они одинаково!"
        },
        {
          "title": "Числа 20–100",
          "text": "Десятки заканчиваются на -ty: twenty, thirty, forty, fifty, sixty, seventy, eighty, ninety. Составные числа пишутся через дефис: 21 twenty-one, 45 forty-five, 99 ninety-nine. 100 — a hundred / one hundred.",
          "tip": "Обрати внимание: forty пишется без u, хотя four — с u."
        }
      ],
      "videos": [
        {
          "title": "Numbers 20–100 in English",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=numbers+20-100+english+for+beginners"
        }
      ],
