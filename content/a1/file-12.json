    "12C": {
      "theory": [
        {
          "title": "Сравнительная степень прилагательных",
          "table": {
            "head": [
              "Прилагательное",
              "Правило",
              "Пример"
            ],
            "rows": [
              [
                "короткое (1 слог)",
                "+ er",
                "cheap → cheaper, old → older"
              ],
              [
                "на -e",
                "+ r",
                "nice → nicer, large → larger"
              ],
              [
                "гласная + согласная",
                "удвоение + er",
                "big → bigger, hot → hotter"
              ],
              [
                "на -y",
                "y → ier",
                "easy → easier, happy → happier"
              ],
              [
                "длинное (2+ слога)",
                "more + прил.",
                "expensive → more expensive"
              ],
              [
                "исключения",
                "—",
                "good → better, bad → worse, far → further"
              ]
            ]
          },
          "examples": [
            {
              "en": "Moscow is bigger than Kazan.",
              "ru": "Москва больше Казани."
            },
            {
              "en": "This phone is more expensive than that one.",
              "ru": "Этот телефон дороже того."
            }
          ],
          "tip": "После сравнения — than (чем), а не that или then. Нельзя: more bigger."
        }
      ],
