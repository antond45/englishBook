    "5A": {
      "theory": [
        {
          "title": "Present Simple: he, she, it",
          "text": "Самое важное правило Present Simple: с he, she, it к глаголу добавляется окончание -s. Его часто забывают!",
          "table": {
            "head": [
              "Правило",
              "Пример"
            ],
            "rows": [
              [
                "обычно + s",
                "work → works, get up → gets up"
              ],
              [
                "-s, -sh, -ch, -x, -o + es",
                "watch → watches, go → goes, do → does"
              ],
              [
                "согласная + y → ies",
                "study → studies"
              ],
              [
                "исключение",
                "have → has"
              ]
            ]
          },
          "examples": [
            {
              "en": "She gets up at seven.",
              "ru": "Она встаёт в семь."
            },
            {
              "en": "He goes to work by bus.",
              "ru": "Он ездит на работу на автобусе."
            },
            {
              "en": "My dad has a big car.",
              "ru": "У моего папы большая машина."
            }
          ],
          "tip": "Окончание -s бывает только в 3-м лице единственного числа: he works, но they work."
        },
        {
          "title": "Распорядок дня",
          "examples": [
            {
              "en": "get up — have a shower — get dressed",
              "ru": "встать — принять душ — одеться"
            },
            {
              "en": "have breakfast — go to work — have lunch",
              "ru": "завтракать — идти на работу — обедать"
            },
            {
              "en": "get home — make dinner — go to bed",
              "ru": "прийти домой — готовить ужин — ложиться спать"
            }
          ]
        }
      ],
