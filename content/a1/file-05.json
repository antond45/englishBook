    "5B": {
      "theory": [
        {
          "title": "Отрицание и вопрос с he, she, it",
          "text": "Для he, she, it используем does / doesn't. Окончание -s переходит во вспомогательный глагол, поэтому основной глагол остаётся без -s.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "She works."
              ],
              [
                "−",
                "She doesn't work. (не doesn't works!)"
              ],
              [
                "?",
                "Does she work?"
              ],
              [
                "Ответ",
                "Yes, she does. / No, she doesn't."
              ]
            ]
          },
          "examples": [
            {
              "en": "What time does he get up?",
              "ru": "Во сколько он встаёт?"
            },
            {
              "en": "Does it rain a lot here?",
              "ru": "Здесь часто идут дожди?"
            }
          ]
        },
        {
          "title": "Части дня",
          "examples": [
            {
              "en": "in the morning",
              "ru": "утром"
            },
            {
              "en": "in the afternoon",
              "ru": "днём (после полудня)"
            },
            {
              "en": "in the evening",
              "ru": "вечером"
            },
            {
              "en": "at night",
              "ru": "ночью"
            }
          ],
          "tip": "Запомни предлоги: in the morning, но at night."
        }
      ],
