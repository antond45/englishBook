    "9C": {
      "theory": [
        {
          "title": "Произношение -ed",
          "table": {
            "head": [
              "Звук",
              "Когда",
              "Примеры"
            ],
            "rows": [
              [
                "/t/",
                "после глухих звуков (p, k, s, sh, ch, f)",
                "worked, stopped, watched, finished"
              ],
              [
                "/d/",
                "после звонких звуков и гласных",
                "lived, played, called, opened"
              ],
              [
                "/ɪd/",
                "после t и d — лишний слог",
                "wanted, started, needed, decided"
              ]
            ]
          },
          "examples": [
            {
              "en": "I walked to work.",
              "ru": "/t/"
            },
            {
              "en": "She played tennis.",
              "ru": "/d/"
            },
            {
              "en": "They wanted pizza.",
              "ru": "/ɪd/"
            }
          ],
          "tip": "Главное правило: «лишний» слог /ɪd/ появляется ТОЛЬКО после t и d. worked — один слог, не «вор-кед»."
        }
      ],
