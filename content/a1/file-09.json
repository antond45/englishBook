    "9A": {
      "theory": [
        {
          "title": "Past Simple: правильные глаголы",
          "text": "Past Simple (простое прошедшее) — для законченных действий в прошлом. У правильных глаголов добавляем -ed. Форма одна для всех лиц!",
          "examples": [
            {
              "en": "I worked yesterday.",
              "ru": "Вчера я работал."
            },
            {
              "en": "She lived in Spain for two years.",
              "ru": "Она прожила в Испании два года."
            },
            {
              "en": "We watched a film last night.",
              "ru": "Вчера вечером мы смотрели фильм."
            }
          ]
        },
        {
          "title": "Правописание -ed",
          "table": {
            "head": [
              "Правило",
              "Пример"
            ],
            "rows": [
              [
                "обычно + ed",
                "work → worked, play → played"
              ],
              [
                "на -e: только + d",
                "live → lived, arrive → arrived"
              ],
              [
                "согласная + y → ied",
                "study → studied, try → tried"
              ],
              [
                "короткий глагол: гласная + согласная → удвоение",
                "stop → stopped, plan → planned"
              ]
            ]
          }
        }
      ],
      "videos": [
        {
          "title": "Past simple regular verbs",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=past+simple+regular+verbs+ed+beginners"
        }
      ],
