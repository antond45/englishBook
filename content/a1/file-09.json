    "9B": {
      "theory": [
        {
          "title": "Отрицание и вопросы в Past Simple",
          "text": "Для всех лиц используем did / didn't. Основной глагол возвращается в начальную форму, без -ed.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I watched the match."
              ],
              [
                "−",
                "I didn't watch the match. (не didn't watched)"
              ],
              [
                "?",
                "Did you watch the match?"
              ],
              [
                "Ответ",
                "Yes, I did. / No, I didn't."
              ],
              [
                "Wh-?",
                "What did you watch?"
              ]
            ]
          },
          "tip": "Прошедшее время показывает только did, поэтому глагол после него — в начальной форме."
        }
      ],
