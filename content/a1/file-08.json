    "8A": {
      "theory": [
        {
          "title": "Прошедшее время be: was / were",
          "text": "am и is в прошедшем времени превращаются в was, are — в were.",
          "table": {
            "head": [
              "",
              "+",
              "−"
            ],
            "rows": [
              [
                "I / he / she / it",
                "was",
                "wasn't"
              ],
              [
                "you / we / they",
                "were",
                "weren't"
              ]
            ]
          },
          "examples": [
            {
              "en": "I was at home yesterday.",
              "ru": "Вчера я был дома."
            },
            {
              "en": "They were in Paris last summer.",
              "ru": "Прошлым летом они были в Париже."
            },
            {
              "en": "The film wasn't very good.",
              "ru": "Фильм был не очень."
            }
          ]
        },
        {
          "title": "Даты",
          "text": "Для дат используем порядковые числительные: 1st first, 2nd second, 3rd third, 4th fourth, 5th fifth… 12th twelfth, 20th twentieth, 21st twenty-first.",
          "examples": [
            {
              "en": "My birthday is on the 3rd of May.",
              "ru": "Мой день рождения 3 мая."
            },
            {
              "en": "It was on the twenty-first of January.",
              "ru": "Это было 21 января."
            }
          ],
          "tip": "С датами — предлог on (on the 5th of June), с месяцами и годами — in (in June, in 1998)."
        }
      ],
      "videos": [
        {
          "title": "Was / were for beginners",
