    "8C": {
      "theory": [
        {
          "title": "Слова-маркеры прошедшего времени",
          "table": {
            "head": [
              "Выражение",
              "Перевод"
            ],
            "rows": [
              [
                "yesterday / yesterday morning",
                "вчера / вчера утром"
              ],
              [
                "last night / last week / last year",
                "вчера вечером / на прошлой неделе / в прошлом году"
              ],
              [
                "two days ago / a month ago",
                "два дня назад / месяц назад"
              ],
              [
                "in 2015 / in the 1990s",
                "в 2015 году / в 1990-х"
              ]
            ]
          },
          "tip": "«Вчера вечером» — last night, а не yesterday night. С last не нужен предлог: last week (не in last week)."
        }
      ],
