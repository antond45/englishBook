    "8B": {
      "theory": [
        {
          "title": "Вопросы с was / were",
          "text": "Как и в настоящем времени, was / were ставится перед подлежащим.",
          "examples": [
            {
              "en": "Was he at work? — Yes, he was. / No, he wasn't.",
              "ru": "Он был на работе?"
            },
            {
              "en": "Were you born in Moscow?",
              "ru": "Ты родился в Москве?"
            },
            {
              "en": "Where were you yesterday?",
              "ru": "Где ты был вчера?"
            },
            {
              "en": "What was your first teacher's name?",
              "ru": "Как звали твою первую учительницу?"
            }
          ],
          "tip": "«Я родился» — всегда I was born (в прошедшем времени, с was). Не говорите I born."
        }
      ],
