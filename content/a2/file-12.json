  "lessons": {
    "12A": {
      "theory": [
        {
          "title": "Present Perfect: опыт",
          "text": "have / has + 3-я форма глагола (past participle). Используем, чтобы рассказать об опыте в жизни, не говоря когда.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I've been to Paris. She's seen this film."
              ],
              [
                "−",
                "I haven't tried sushi. He hasn't met her."
              ],
              [
                "?",
                "Have you ever been to Japan? — Yes, I have. / No, I haven't."
              ]
            ]
          },
          "examples": [
            {
              "en": "Have you ever ridden a horse?",
              "ru": "Ты когда-нибудь ездил верхом?"
            },
            {
              "en": "I've never flown in a helicopter.",
              "ru": "Я никогда не летал на вертолёте."
            }
          ],
          "tip": "been vs gone: She's been to London (была и вернулась). She's gone to London (уехала и сейчас там)."
        },
        {
          "title": "Третья форма",
          "text": "Правильные: = Past (worked, visited). Неправильные: be → been, do → done, see → seen, eat → eaten, write → written, fly → flown, meet → met, buy → bought, win → won, break → broken."
        }
      ],
      "videos": [
        {
          "title": "Present perfect for experience",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=present+perfect+have+you+ever+elementary"
        }
      ],
