    "12C": {
      "theory": [
        {
          "title": "Повторение времён",
          "table": {
            "head": [
              "Время",
              "Когда",
              "Пример"
            ],
            "rows": [
              [
                "Present Simple",
                "привычки, факты",
                "I work in a bank."
              ],
              [
                "Present Continuous",
                "сейчас, временно",
                "I'm working from home this week."
              ],
              [
                "Past Simple",
                "законченное в прошлом",
                "I worked in a shop in 2015."
              ],
              [
                "Present Perfect",
                "опыт",
                "I've worked abroad."
              ],
              [
                "be going to",
                "планы",
                "I'm going to change jobs."
              ]
            ]
          },
          "tip": "Ищи слова-подсказки: usually → Simple, now → Continuous, yesterday / ago → Past, ever / never → Perfect, next → going to."
        },
        {
          "title": "Порядок слов в вопросах (повторение)",
          "text": "Вопросительное слово + вспомогательный глагол (do/does/did/am/is/are/have/has) + подлежащее + глагол."
        }
      ],
