    "12B": {
      "theory": [
        {
          "title": "Present Perfect или Past Simple?",
          "table": {
            "head": [
              "Present Perfect",
              "Past Simple"
            ],
            "rows": [
              [
                "опыт, без «когда»",
                "конкретное время в прошлом"
              ],
              [
                "Have you ever been to Rome?",
                "When did you go there?"
              ],
              [
                "I've seen that film.",
                "I saw it last year."
              ]
            ]
          },
          "text": "Разговор часто начинается с Present Perfect (общий вопрос), а детали — в Past Simple.",
          "examples": [
            {
              "en": "Have you ever lost your passport? — Yes, I have. I lost it in Spain in 2019.",
              "ru": "Ты когда-нибудь терял паспорт? — Да. Потерял в Испании в 2019."
            }
          ],
          "tip": "С yesterday, last…, ago, in 2010, when… — только Past Simple."
        }
      ],
      "exercises": [
        {
