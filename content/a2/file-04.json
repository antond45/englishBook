    "4B": {
      "theory": [
        {
          "title": "Предлоги времени: at, in, on",
          "table": {
            "head": [
              "Предлог",
              "С чем",
              "Примеры"
            ],
            "rows": [
              [
                "at",
                "время, праздники, выходные",
                "at 7 o'clock, at night, at the weekend, at Christmas"
              ],
              [
                "in",
                "части дня, месяцы, годы, времена года",
                "in the morning, in May, in 2010, in winter"
              ],
              [
                "on",
                "дни, даты",
                "on Monday, on 5th March, on my birthday"
              ]
            ]
          },
          "tip": "Без предлога: today, tomorrow, every day, next week, last year."
        },
        {
          "title": "Распорядок дня",
          "examples": [
