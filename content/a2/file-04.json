    "4C": {
      "theory": [
        {
          "title": "Наречия и выражения частоты",
          "text": "always, usually, often, sometimes, hardly ever, never — перед основным глаголом, но после be. Выражения every day, once a week, twice a month, three times a year — обычно в конце.",
          "examples": [
            {
              "en": "I hardly ever eat out.",
              "ru": "Я почти никогда не ем в ресторанах."
            },
            {
              "en": "She's usually at home on Sundays.",
              "ru": "По воскресеньям она обычно дома."
            },
            {
              "en": "We go swimming twice a week.",
              "ru": "Мы ходим плавать дважды в неделю."
            }
          ],
          "tip": "Вопрос: How often do you…? Ответ: Every day / Once a week / Never."
        }
      ],
