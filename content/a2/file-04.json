    "4A": {
      "theory": [
        {
          "title": "Притяжательный 's",
          "text": "Владелец + 's + предмет: Kate's car (машина Кейт). Если существительное во множественном числе на -s — только апостроф: my parents' house. Для неправильных множественных — 's: the children's toys.",
          "examples": [
            {
              "en": "my sister's husband",
              "ru": "муж моей сестры"
            },
            {
              "en": "my grandparents' farm",
              "ru": "ферма моих бабушки и дедушки"
            },
            {
              "en": "Whose is this? — It's Tom's.",
              "ru": "Чьё это? — Тома."
            }
          ]
        },
        {
          "title": "Семья",
          "examples": [
            {
              "en": "stepmother, stepfather",
              "ru": "мачеха, отчим"
            },
            {
              "en": "mother-in-law, brother-in-law",
              "ru": "свекровь/тёща, шурин/деверь/зять"
            },
            {
              "en": "an only child, twins",
              "ru": "единственный ребёнок, близнецы"
            },
            {
              "en": "relatives",
              "ru": "родственники"
            }
          ]
        }
      ],
