    "6B": {
      "theory": [
        {
          "title": "like / love / hate / don't mind + -ing",
          "text": "После этих глаголов следующий глагол — с окончанием -ing.",
          "examples": [
            {
              "en": "I don't mind cooking, but I hate washing up.",
              "ru": "Я не против готовить, но ненавижу мыть посуду."
            },
            {
              "en": "Do you like dancing?",
              "ru": "Ты любишь танцевать?"
            }
          ],
          "tip": "I'd like (= would like) + to: I'd like to go. Это другое значение: «хотел бы»."
        },
        {
          "title": "Даты",
          "text": "Порядковые числительные: first, second, third, fourth, fifth… twentieth, twenty-first, thirtieth. Пишем 3rd May, говорим the third of May или May the third.",
          "examples": [
            {
              "en": "When's your birthday? — It's on the twenty-second of October.",
              "ru": "Когда день рождения? — 22 октября."
            }
          ]
        }
      ],
