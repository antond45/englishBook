    "2C": {
      "theory": [
        {
          "title": "Повелительное наклонение (imperatives)",
          "text": "Глагол в начальной форме — приказ, совет, инструкция. Отрицание: Don't + глагол. Чтобы звучало вежливо, добавляй please.",
          "examples": [
            {
              "en": "Open the window, please.",
              "ru": "Открой окно, пожалуйста."
            },
            {
              "en": "Don't worry!",
              "ru": "Не волнуйся!"
            },
            {
              "en": "Be careful!",
              "ru": "Будь осторожен!"
            }
          ]
        },
        {
          "title": "Let's…",
          "text": "Let's + глагол — предложение сделать что-то вместе. Let's not… — давай не будем.",
          "examples": [
            {
              "en": "Let's go to the cinema.",
              "ru": "Давай сходим в кино."
            },
            {
              "en": "Let's not take a taxi.",
              "ru": "Давай не будем брать такси."
            }
          ]
        },
        {
          "title": "Чувства",
          "text": "hungry, thirsty, tired, cold, hot, bored, angry, worried, stressed, happy. Говорим с be: I'm hungry (не I have hungry)."
        }
      ],
