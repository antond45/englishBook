    "2B": {
      "theory": [
        {
          "title": "Прилагательные",
          "text": "Прилагательные не меняются по числу: an old car — old cars. Стоят перед существительным или после be. Усиление: very, really; ослабление: quite, a bit (только с негативными: a bit cold).",
          "examples": [
            {
              "en": "It's a really beautiful city.",
              "ru": "Это очень красивый город."
            },
            {
              "en": "The hotel was quite cheap.",
              "ru": "Отель был довольно дешёвым."
            }
          ]
        },
