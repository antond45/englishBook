    "2A": {
      "theory": [
        {
          "title": "a / an и множественное число",
          "text": "a — перед согласным звуком, an — перед гласным: a phone, an umbrella, an hour. Множественное число: + s (keys), + es после s/sh/ch/x (watches), y → ies (diaries). Исключения: men, women, children, people.",
          "examples": [
            {
              "en": "an ID card, a wallet, two coins",
              "ru": "удостоверение, кошелёк, две монеты"
            },
            {
              "en": "These are my keys.",
              "ru": "Это мои ключи."
            }
          ]
        },
        {
          "title": "this / that / these / those",
          "table": {
            "head": [
              "",
              "Рядом",
              "Далеко"
            ],
            "rows": [
              [
                "Один",
                "this",
                "that"
              ],
              [
                "Много",
                "these",
                "those"
              ]
            ]
          },
          "tip": "В вопросах о предметах часто опускают существительное: What's that? What are those?"
        }
      ],
      "videos": [
        {
          "title": "This, that, these, those",
          "kind": "youtube-search",
