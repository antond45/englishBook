    "7B": {
      "theory": [
        {
          "title": "Past Simple: правильные глаголы",
          "text": "Глагол + -ed для всех лиц. Отрицание: didn't + глагол. Вопрос: Did + подлежащее + глагол?",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I watched a film."
              ],
              [
                "−",
                "I didn't watch the news."
              ],
              [
                "?",
                "Did you watch it? — Yes, I did."
              ]
            ]
          },
          "tip": "Правописание: live → lived, stop → stopped, study → studied, play → played."
        },
        {
          "title": "Слова прошедшего времени",
          "text": "yesterday, last night/week/month, two days ago, in 2020, when I was a child. «Вчера вечером» = last night."
        }
      ],
