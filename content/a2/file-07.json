    "7A": {
      "theory": [
        {
          "title": "Past Simple глагола be",
          "table": {
            "head": [
              "",
              "I / he / she / it",
              "you / we / they"
            ],
            "rows": [
              [
                "+",
                "was",
                "were"
              ],
              [
                "−",
                "wasn't",
                "weren't"
              ],
              [
                "?",
                "Was he…?",
                "Were they…?"
              ]
            ]
          },
          "examples": [
            {
              "en": "Where were you born? — I was born in Tula.",
              "ru": "Где ты родился? — В Туле."
            },
            {
              "en": "Was it expensive? — No, it wasn't.",
              "ru": "Было дорого? — Нет."
            }
          ]
        },
        {
          "title": "Образование слов: профессии",
          "table": {
            "head": [
              "Окончание",
              "Примеры"
            ],
            "rows": [
              [
                "-er",
                "paint → painter, write → writer"
              ],
              [
                "-or",
                "act → actor, invent → inventor"
              ],
              [
                "-ist",
                "art → artist, science → scientist"
              ],
              [
                "-ian",
                "music → musician, politics → politician"
              ]
            ]
          }
        }
      ],
      "videos": [
        {
          "title": "Was / were (elementary)",
          "kind": "youtube-search",
