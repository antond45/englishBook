    "8B": {
      "theory": [
        {
          "title": "there is / there are + some / any",
          "table": {
            "head": [
              "",
              "Ед. число",
              "Мн. число"
            ],
            "rows": [
              [
                "+",
                "There's a fireplace.",
                "There are some plants."
              ],
              [
                "−",
                "There isn't a garden.",
                "There aren't any chairs."
              ],
              [
                "?",
                "Is there a lift?",
                "Are there any shops?"
              ]
            ]
          },
          "tip": "some — в утверждениях, any — в отрицаниях и вопросах. В предложении с перечислением: There's a sofa and two armchairs (выбираем по первому предмету)."
        },
        {
          "title": "Дом",
          "text": "upstairs, downstairs, ground floor, first floor, a balcony, a garage, a fireplace, a wardrobe, a shelf, a carpet, a mirror, curtains."
        }
      ],
