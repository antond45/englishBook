    "11B": {
      "theory": [
        {
          "title": "Глагол + to + глагол",
          "text": "После некоторых глаголов следующий глагол идёт с to: want, need, would like, decide, hope, plan, try, learn, forget, remember, promise, offer.",
          "examples": [
            {
              "en": "I decided to learn Japanese.",
              "ru": "Я решил выучить японский."
            },
            {
              "en": "Don't forget to call me!",
              "ru": "Не забудь позвонить!"
            },
            {
              "en": "She's learning to drive.",
              "ru": "Она учится водить."
            }
          ],
          "tip": "Отрицание ставится перед to: I decided not to go."
        }
      ],
