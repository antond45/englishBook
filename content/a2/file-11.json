    "11A": {
      "theory": [
        {
          "title": "Наречия образа действия",
          "text": "Отвечают на вопрос «как?». Обычно прилагательное + ly: slow → slowly, careful → carefully, quiet → quietly. -y → ily: easy → easily.",
          "table": {
            "head": [
              "Прилагательное",
              "Наречие"
            ],
            "rows": [
              [
                "good",
                "well"
              ],
              [
                "fast",
                "fast"
              ],
              [
                "hard",
                "hard"
              ],
              [
                "late",
                "late"
              ],
              [
                "early",
                "early"
              ]
            ]
          },
          "examples": [
            {
              "en": "She speaks English very well.",
              "ru": "Она очень хорошо говорит по-английски."
            },
            {
              "en": "Drive carefully!",
              "ru": "Езжай осторожно!"
            }
          ],
          "tip": "Прилагательное описывает существительное (a careful driver), наречие — глагол (he drives carefully). hardly = «почти не», а не «тяжело»!"
        }
      ],
      "videos": [
        {
          "title": "Adverbs of manner",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=adverbs+of+manner+elementary+english"
