    "9A": {
      "theory": [
        {
          "title": "Исчисляемые и неисчисляемые",
          "text": "Исчисляемые: an egg, two eggs. Неисчисляемые: rice, pasta, cheese, bread, meat, fruit, milk, sugar, money, information — без a/an и без -s.",
          "table": {
            "head": [
              "",
              "Исчисляемые",
              "Неисчисляемые"
            ],
            "rows": [
              [
                "+",
                "a banana / some bananas",
                "some rice"
              ],
              [
                "−",
                "any bananas",
                "any rice"
              ],
              [
                "?",
                "any bananas?",
                "any rice?"
              ]
            ]
          },
          "tip": "fruit обычно неисчисляемое: I eat a lot of fruit (не fruits)."
        },
        {
          "title": "Еда",
          "text": "beef, chicken, lamb, salmon, prawns; carrots, onions, peppers, mushrooms; pears, grapes, cherries; cereal, biscuits, crisps, butter, yoghurt."
        }
      ],
      "videos": [
        {
          "title": "Countable and uncountable nouns (A2)",
          "kind": "youtube-search",
