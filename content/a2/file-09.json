    "9C": {
      "theory": [
        {
          "title": "be going to — планы",
          "text": "am/is/are + going to + глагол — уже решённые планы на будущее.",
          "examples": [
            {
              "en": "I'm going to start a diet on Monday.",
              "ru": "С понедельника я сажусь на диету."
            },
            {
              "en": "We aren't going to buy a car this year.",
              "ru": "В этом году мы не будем покупать машину."
            },
            {
              "en": "What are you going to do this summer?",
              "ru": "Что ты собираешься делать летом?"
            }
          ],
          "tip": "С go часто говорят просто: I'm going to the cinema (вместо I'm going to go to…)."
        },
        {
          "title": "Слова будущего",
          "text": "tonight, tomorrow morning, this weekend, next week, next month, in two years, soon, one day."
        }
      ],
