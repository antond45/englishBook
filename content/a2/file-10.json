    "10A": {
      "theory": [
        {
          "title": "Сравнительная степень",
          "table": {
            "head": [
              "Тип",
              "Пример"
            ],
            "rows": [
              [
                "1 слог: + er",
                "old → older, cheap → cheaper"
              ],
              [
                "-e: + r",
                "nice → nicer"
              ],
              [
                "гласная + согласная: удвоение",
                "big → bigger, thin → thinner"
              ],
              [
                "-y → ier",
                "funny → funnier, lazy → lazier"
              ],
              [
                "2+ слога: more",
                "more generous, more relaxed"
              ],
              [
                "исключения",
                "good → better, bad → worse, far → further"
              ]
            ]
          },
          "examples": [
            {
              "en": "My brother is more patient than me.",
              "ru": "Мой брат терпеливее меня."
            }
          ],
          "tip": "После сравнения — than + me / him / her (в разговоре): She's taller than me."
        },
        {
          "title": "Черты характера",
          "text": "generous, mean, lazy, hard-working, patient, impatient, shy, outgoing, funny, serious, kind, unfriendly."
        }
      ],
      "videos": [
        {
