            ],
            "rows": [
              [
                "I",
                "am",
                "I'm"
              ],
              [
                "you / we / they",
                "are",
                "you're / we're / they're"
              ],
              [
                "he / she / it",
                "is",
                "he's / she's / it's"
              ]
            ]
          },
          "examples": [
            {
              "en": "We're in the same class.",
              "ru": "Мы в одной группе."
            },
            {
              "en": "It's Monday today.",
              "ru": "Сегодня понедельник."
            }
          ],
          "tip": "Дни недели всегда с большой буквы и с предлогом on: on Monday, on Fridays (по пятницам)."
