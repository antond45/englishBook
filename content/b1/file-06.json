  "lessons": {
    "6A": {
      "theory": [
        {
          "title": "Инфинитив с to",
          "table": {
            "head": [
              "Когда",
              "Пример"
            ],
            "rows": [
              [
                "после некоторых глаголов: want, need, decide, hope, plan, promise, offer, refuse, try, learn, forget, manage, pretend",
                "I managed to finish on time."
              ],
              [
                "после прилагательных",
                "It's easy to make. Nice to meet you."
              ],
              [
                "чтобы выразить цель (зачем?)",
                "I went out to buy some bread."
              ],
              [
                "после вопросительных слов",
                "I don't know what to do."
              ]
            ]
          },
          "tip": "Цель по-русски «чтобы» → просто to: I came to help (не for help и не for to help)."
        }
      ],
      "videos": [
        {
          "title": "Infinitive with to",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=infinitive+with+to+uses+pre-intermediate"
        }
      ],
      "exercises": [
        {
