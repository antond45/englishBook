    "6B": {
      "theory": [
        {
          "title": "Форма -ing (герундий)",
          "table": {
            "head": [
              "Когда",
              "Пример"
            ],
            "rows": [
              [
                "как подлежащее",
                "Swimming is good for you."
              ],
              [
                "после предлогов",
                "I'm good at cooking. Thanks for coming."
              ],
              [
                "после глаголов: enjoy, like, love, hate, don't mind, finish, stop, avoid, spend time, keep, feel like, can't stand",
                "I can't stand waiting."
              ]
            ]
          },
          "tip": "После любого предлога — только -ing: interested in learning, before leaving, without saying."
        }
      ],
