    "10C": {
      "theory": [
        {
          "title": "So do I / Neither do I",
          "text": "Чтобы выразить согласие («я тоже»), используем so (для утверждений) или neither (для отрицаний) + вспомогательный глагол + подлежащее.",
          "table": {
            "head": [
              "Фраза",
              "Я тоже",
              "А я нет"
            ],
            "rows": [
              [
                "I love jazz.",
                "So do I.",
                "I don't."
              ],
              [
                "I'm tired.",
                "So am I.",
                "I'm not."
              ],
              [
                "I can't swim.",
                "Neither can I.",
                "I can."
              ],
              [
                "I didn't go.",
                "Neither did I.",
                "I did."
              ],
              [
                "I've been to Rome.",
                "So have I.",
                "I haven't."
              ]
            ]
          },
          "tip": "Вспомогательный глагол повторяет время и тип исходного: am → am, went → did, can't → can."
        }
      ],
