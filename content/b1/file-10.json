    "10B": {
      "theory": [
        {
          "title": "Фразовые глаголы: порядок слов",
          "text": "Фразовый глагол = глагол + частица (up, off, on, out…), значение часто меняется. Если глагол разделяемый, дополнение-существительное может стоять до или после частицы, а местоимение — только между.",
          "examples": [
            {
              "en": "Turn off the light. / Turn the light off.",
              "ru": "Оба варианта правильные."
            },
            {
              "en": "Turn it off. (не Turn off it)",
              "ru": "Местоимение — только в середине."
            },
            {
              "en": "I'm looking for my keys. (неразделяемый)",
              "ru": "look for, get on, look after — не разделяются."
            }
          ]
        },
        {
          "title": "Частые фразовые глаголы",
          "table": {
            "head": [
              "Глагол",
              "Значение"
            ],
            "rows": [
              [
                "turn on / off / up / down",
                "включить / выключить / громче / тише"
              ],
              [
                "put on / take off",
                "надеть / снять"
              ],
              [
                "pick up",
                "поднять, забрать"
              ],
              [
                "give up",
