    "10A": {
      "theory": [
        {
          "title": "Глаголы движения + предлоги",
          "text": "В английском направление часто выражается предлогом после глагола: run across the road (перебежать), swim under the bridge (проплыть под мостом).",
          "table": {
            "head": [
              "Предлог",
              "Значение",
              "Пример"
            ],
            "rows": [
              [
                "across",
                "через (поверхность)",
                "walk across the park"
              ],
              [
                "through",
                "сквозь, через (внутри)",
                "drive through the tunnel"
              ],
              [
                "along",
                "вдоль",
                "run along the river"
              ],
              [
                "over / under",
                "над, через / под",
                "jump over the fence / go under the bridge"
              ],
              [
                "up / down",
                "вверх / вниз",
                "climb up the hill"
              ],
              [
                "into / out of",
                "в / из",
                "jump into the water"
              ],
              [
                "past",
                "мимо",
                "go past the church"
              ]
            ]
          }
        },
        {
          "title": "Спорт",
          "text": "go + -ing: go swimming, go cycling, go skiing; play + игры с мячом: play football, tennis; do + единоборства и др.: do yoga, do karate. score a goal, win / lose a match, a referee, a pitch, a court, a stadium."
        }
      ],
