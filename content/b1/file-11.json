        {
          "id": "11a-3",
          "type": "transform",
          "instruction": "Join the sentences with because + past perfect.",
          "items": [
            {
              "prompt": "She was tired. She worked all night.",
              "answers": [
                "She was tired because she had worked all night.",
                "She was tired because she'd worked all night."
              ]
            },
            {
              "prompt": "I didn't watch the film. I saw it before.",
              "answers": [
                "I didn't watch the film because I had seen it before.",
                "I didn't watch the film because I'd seen it before."
              ]
            }
          ]
        },
        {
          "id": "11a-4",
          "type": "matching",
          "instruction": "Match the halves.",
          "pairs": [
            {
              "left": "The streets were wet",
