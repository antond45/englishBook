    "11B": {
      "theory": [
        {
          "title": "Косвенная речь",
          "text": "Когда пересказываем чужие слова (said, told), время обычно сдвигается «на шаг назад», меняются местоимения и некоторые слова.",
          "table": {
            "head": [
              "Прямая речь",
              "Косвенная речь"
            ],
            "rows": [
              [
                "\"I'm tired.\"",
                "She said (that) she was tired."
              ],
              [
                "\"I live in Moscow.\"",
                "He said he lived in Moscow."
              ],
              [
                "\"I'll call you.\"",
                "He said he would call me."
              ],
              [
                "\"I've lost my key.\"",
                "She said she had lost her key."
              ],
              [
                "\"I can help.\"",
                "He said he could help."
              ]
            ]
          },
          "tip": "say vs tell: say something (to someone), tell someone something. She said that… / She told me that… (не She said me)."
        }
      ],
      "exercises": [
        {
          "id": "11b-1",
          "type": "transform",
          "instruction": "Report the sentences. Start with He said / She said.",
          "items": [
            {
              "prompt": "\"I'm hungry,\" said Tom.",
              "answers": [
                "He said he was hungry.",
                "He said that he was hungry."
              ]
            },
            {
              "prompt": "\"I'll be late,\" said Anna.",
              "answers": [
                "She said she would be late.",
                "She said that she would be late.",
                "She said she'd be late."
              ]
            },
            {
              "prompt": "\"I can't swim,\" said Max.",
              "answers": [
                "He said he couldn't swim.",
                "He said that he couldn't swim."
              ]
            }
          ]
        },
        {
