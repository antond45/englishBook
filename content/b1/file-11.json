    "11C": {
      "theory": [
        {
          "title": "Вопросы без вспомогательного глагола",
          "text": "Если вопрос задаётся к подлежащему (who/what сделал?), вспомогательный глагол не нужен, порядок прямой.",
          "table": {
            "head": [
              "Вопрос к подлежащему",
              "Вопрос к дополнению"
            ],
            "rows": [
              [
                "Who wrote War and Peace? — Tolstoy.",
                "What did Tolstoy write? — War and Peace."
              ],
              [
                "What happened?",
                "What did you do?"
              ],
              [
                "Which team won?",
                "Which team did you support?"
              ],
              [
                "How many people came?",
                "How many people did you invite?"
              ]
            ]
          },
          "tip": "Проверка: если ответ — это тот, кто делал действие, вопрос без do/did."
        }
      ],
