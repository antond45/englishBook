    "2C": {
      "theory": [
        {
          "title": "Связки в рассказе",
          "table": {
            "head": [
              "Группа",
              "Слова"
            ],
            "rows": [
              [
                "Последовательность",
                "First, Then, Next, After that, Later, Finally / In the end"
              ],
              [
                "Время",
                "One day, When, While, As soon as, Suddenly"
              ],
              [
                "Связь мыслей",
                "so (поэтому), because (потому что), but (но), although (хотя)"
              ]
            ]
          },
          "examples": [
            {
              "en": "It was late, so we took a taxi.",
              "ru": "Было поздно, поэтому мы взяли такси."
            },
            {
              "en": "Although it was raining, we went for a walk.",
              "ru": "Хотя шёл дождь, мы пошли гулять."
            },
            {
              "en": "As soon as I got home, I went to bed.",
              "ru": "Как только я пришёл домой, я лёг спать."
            }
          ],
          "tip": "In the end = в итоге (после цепочки событий). At the end of = в конце чего-то (at the end of the film)."
        }
      ],
