    "2B": {
      "theory": [
        {
          "title": "Past Continuous",
          "text": "was / were + -ing. Описывает действие в процессе в определённый момент прошлого или фон для другого действия.",
          "table": {
            "head": [
              "",
              "Пример"
            ],
            "rows": [
              [
                "+",
                "I was reading. They were having dinner."
              ],
              [
                "−",
                "She wasn't listening."
              ],
              [
                "?",
                "What were you doing at 8 p.m.?"
              ]
            ]
          },
          "examples": [
            {
              "en": "At 10 o'clock I was sleeping.",
              "ru": "В 10 часов я спал. (в процессе)"
            },
            {
              "en": "I was walking home when I saw an accident.",
              "ru": "Я шёл домой, когда увидел аварию. (фон + событие)"
            },
            {
              "en": "While she was cooking, he was watching TV.",
              "ru": "Пока она готовила, он смотрел ТВ. (два процесса)"
            }
          ],
          "tip": "when + Past Simple (короткое событие), while + Past Continuous (длительный процесс)."
        },
        {
          "title": "at / in / on: время и место",
          "text": "at: at 5 o'clock, at the weekend, at home, at work, at the station. in: in July, in the morning, in the kitchen, in Paris. on: on Monday, on 3rd May, on the bus, on the beach, on the first floor."
        }
      ],
