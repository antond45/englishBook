    "2A": {
      "theory": [
        {
          "title": "Past Simple: повторение",
          "text": "Законченные действия в прошлом с известным временем. Правильные глаголы + -ed, неправильные — 2-я форма (went, took, flew). Вопрос и отрицание — did + инфинитив.",
          "examples": [
            {
              "en": "We flew to Antalya and stayed in a resort.",
              "ru": "Мы полетели в Анталью и остановились на курорте."
            },
            {
              "en": "Did you sunbathe? — No, I didn't. It rained!",
              "ru": "Ты загорал? — Нет. Шёл дождь!"
            }
          ],
          "tip": "Произношение -ed: /t/ (walked), /d/ (stayed), /ɪd/ — только после t/d (rented, landed)."
        },
        {
          "title": "Отпуск",
          "text": "go abroad, go sightseeing, go camping, sunbathe, rent an apartment, stay in a hotel / with friends, hire a car, book a flight, have a great time, it was crowded / overrated / breathtaking."
        }
      ],
      "videos": [
        {
          "title": "Past simple review (B1)",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=past+simple+review+pre-intermediate"
        }
      ],
