    "7C": {
      "theory": [
        {
          "title": "Притяжательные местоимения",
          "table": {
            "head": [
              "Прилагательное (+ сущ.)",
              "Местоимение (без сущ.)"
            ],
            "rows": [
              [
                "my",
                "mine"
              ],
              [
                "your",
                "yours"
              ],
              [
                "his",
                "his"
              ],
              [
                "her",
                "hers"
              ],
              [
                "our",
                "ours"
              ],
              [
                "their",
                "theirs"
              ]
            ]
          },
          "examples": [
            {
              "en": "Is this your bag? — No, it isn't mine. It's hers.",
              "ru": "Это твоя сумка? — Нет, не моя. Её."
            },
            {
              "en": "Whose is this? — It's ours.",
              "ru": "Чьё это? — Наше."
            }
          ],
          "tip": "Апострофа нет: yours, hers, ours (не your's, her's)."
        },
        {
          "title": "Наречия образа действия",
          "text": "Прилагательное + ly: quick → quickly, careful → carefully, happy → happily. Исключения: good → well, fast → fast, hard → hard, late → late. hardly = почти не, lately = в последнее время."
        }
      ],
