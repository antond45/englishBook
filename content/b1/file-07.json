    "7B": {
      "theory": [
        {
          "title": "First Conditional",
          "text": "Реальное условие в будущем: if + Present Simple, will + инфинитив. Части можно менять местами (без запятой, если if во второй части).",
          "examples": [
            {
              "en": "If it rains, we'll stay at home.",
              "ru": "Если пойдёт дождь, мы останемся дома."
            },
            {
              "en": "You'll miss the bus if you don't hurry.",
              "ru": "Ты опоздаешь на автобус, если не поторопишься."
            }
          ],
          "tip": "После if — НЕ will: If it rains (не If it will rain). Так же после when, as soon as, unless (= if not): Unless you hurry, you'll be late."
        },
        {
          "title": "Слова, которые путают",
          "table": {
            "head": [
              "",
              ""
            ],
            "rows": [
              [
                "lend (давать в долг) / borrow (брать в долг)",
                "win (матч, приз) / earn (деньги за работу)"
              ],
              [
                "look (смотреть) / look like (быть похожим)",
                "know (знать) / meet (знакомиться)"
              ],
              [
                "wait (ждать) / hope (надеяться) / expect (ожидать)",
                "bring (принести сюда) / take (отнести туда)"
              ]
            ]
          }
        }
      ],
