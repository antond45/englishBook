    "7A": {
      "theory": [
        {
          "title": "should / shouldn't — совет",
          "text": "should + инфинитив без to — совет, мнение о том, что правильно.",
          "examples": [
            {
              "en": "You should see a doctor.",
              "ru": "Тебе стоит сходить к врачу."
            },
            {
              "en": "You shouldn't eat so late.",
              "ru": "Не стоит есть так поздно."
            },
            {
              "en": "Should I tell him? — I think you should.",
              "ru": "Сказать ему? — Думаю, стоит."
            }
          ],
          "tip": "should мягче, чем must. I think you should… / I don't think you should… — очень частые вежливые формы."
        },
        {
          "title": "Значения get",
          "table": {
