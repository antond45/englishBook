    "5A": {
      "theory": [
        {
          "title": "Сравнения: прилагательные и наречия",
          "text": "Сравнительная степень наречий строится так же, как прилагательных: fast → faster, slowly → more slowly, well → better, badly → worse.",
          "examples": [
            {
              "en": "She drives more carefully than her husband.",
              "ru": "Она водит осторожнее мужа."
            },
            {
              "en": "I work harder than before.",
              "ru": "Я работаю больше, чем раньше."
            }
          ]
        },
        {
          "title": "as … as",
          "table": {
            "head": [
              "Конструкция",
              "Значение",
              "Пример"
            ],
            "rows": [
              [
                "as + прил. + as",
                "такой же, как",
                "He's as tall as his father."
              ],
              [
                "not as + прил. + as",
                "не такой, как",
                "Trains aren't as fast as planes."
              ],
              [
                "the same as",
                "такой же",
                "My phone is the same as yours."
              ]
            ]
          },
          "tip": "После as и than в разговоре — me, him, her: She's as old as me."
        },
        {
          "title": "Время: spend, waste, save",
          "text": "spend time (проводить), waste time (тратить впустую), save time (экономить), have time for, be in a hurry, be on time, take your time."
        }
      ],
      "videos": [
