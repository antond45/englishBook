    "1A": {
      "theory": [
        {
          "title": "Порядок слов в вопросах: формула",
          "text": "Почти все вопросы строятся по одной схеме. Если её запомнить, ошибок станет намного меньше.",
          "table": {
            "head": [
              "Вопр. слово",
              "Вспом. глагол",
              "Подлежащее",
              "Глагол",
              "…"
            ],
            "rows": [
              [
                "Where",
                "do",
                "you",
                "live",
                "?"
              ],
              [
                "What",
                "did",
                "you",
                "do",
                "last weekend?"
              ],
              [
                "How often",
                "does",
                "she",
                "go",
                "to the gym?"
              ],
              [
                "—",
                "Are",
                "you",
                "going",
                "to study next year?"
              ]
            ]
          }
        },
        {
          "title": "Три важных случая",
          "examples": [
            {
              "en": "Where are you from? (be — без do)",
              "ru": "С глаголом be вспомогательный глагол не нужен."
            },
            {
              "en": "Who do you live with? (предлог в конце)",
              "ru": "Предлог обычно уходит в конец вопроса."
            },
            {
              "en": "What kind of music do you like?",
              "ru": "What kind of / What sort of — «какой (тип)»."
            }
          ],
          "tip": "Частая ошибка русскоязычных — пропуск вспомогательного глагола: Where you work? Правильно: Where do you work?"
        }
      ],
      "videos": [
        {
          "title": "Word order in questions (pre-intermediate)",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=word+order+in+questions+english+pre-intermediate"
        }
      ],
      "exercises": [
