              "kind": "choice",
              "question": "How many questions were there?",
              "options": [
                "16",
                "36",
                "63"
              ],
              "answer": 1
            },
            {
              "kind": "tf",
              "statement": "The questions started very personal.",
              "answer": false
            },
            {
              "kind": "gap",
              "text": "At the end they looked into each other's eyes for ___ minutes.",
              "answers": [
