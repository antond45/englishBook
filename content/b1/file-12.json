    "12B": {
      "theory": [
        {
          "title": "Разделительные вопросы (question tags)",
          "text": "Короткий вопрос в конце («не так ли?», «да?»): утверждение + отрицательный хвост, отрицание + положительный хвост. Хвост повторяет вспомогательный глагол.",
          "table": {
            "head": [
              "Предложение",
              "Хвост"
            ],
            "rows": [
              [
                "You're French,",
                "aren't you?"
              ],
              [
                "She lives here,",
                "doesn't she?"
              ],
              [
                "They didn't come,",
                "did they?"
              ],
              [
                "You've been to Rome,",
                "haven't you?"
              ],
              [
                "He can swim,",
                "can't he?"
              ],
              [
                "I'm late,",
                "aren't I?"
              ]
            ]
          },
          "tip": "Интонация вниз ↘ — ждём согласия; вверх ↗ — настоящий вопрос."
        },
        {
          "title": "Преступления",
          "text": "a thief / steal, a burglar / break into, a robber / rob, a pickpocket, a vandal; arrest, charge, a witness, a fine, prison, guilty / innocent."
        }
      ],
