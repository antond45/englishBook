        {
          "id": "12a-r",
          "type": "reading",
          "instruction": "Read and answer.",
          "title": "Words that don't exist in English",
          "text": "Some languages have words which English needs a whole sentence to translate. In Japanese, 'tsundoku' describes a person who buys books but never reads them. In Swedish, 'fika' is a break where you drink coffee and eat something sweet with colleagues. And in Russian, 'pochemuchka' is a child who asks too many questions. Maybe English will borrow some of them one day!",
          "questions": [
            {
              "kind": "choice",
              "question": "'Tsundoku' describes someone who…",
              "options": [
                "reads a lot",
                "buys books but doesn't read them",
                "writes books"
              ],
              "answer": 1
            },
            {
              "kind": "gap",
              "text": "'Fika' is a Swedish word for a coffee ___.",
              "answers": [
                "break"
              ]
            },
            {
              "kind": "tf",
              "statement": "'Pochemuchka' is a child who asks many questions.",
              "answer": true
            }
          ],
          "image": "📖"
        },
