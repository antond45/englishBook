{
  "fileId": "12",
  "lessons": {
    "12A": {
      "theory": [
        {
          "title": "Определительные придаточные: who, which, that, where",
          "table": {
            "head": [
              "Слово",
              "Для чего",
              "Пример"
            ],
            "rows": [
              [
                "who",
                "люди",
                "She's the woman who lives next door."
              ],
              [
                "which",
                "вещи, животные",
                "It's a machine which makes coffee."
              ],
              [
                "that",
                "люди и вещи (в разговоре)",
                "The book that I'm reading is great."
              ],
              [
                "where",
                "места",
                "That's the café where we met."
              ]
            ]
          },
          "tip": "Если who/which/that — дополнение (после него есть подлежащее), его можно опустить: The book (that) I'm reading… Если подлежащее — нельзя: The man who called…"
        },
        {
          "title": "Перефразирование",
          "text": "Когда не знаешь слова, опиши его: It's a thing which you use to…, It's a person who…, It's a place where…, It's like a… but…"
        }
      ],
      "videos": [
        {
          "title": "Relative clauses who which where",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=defining+relative+clauses+who+which+where"
        }
      ],
      "exercises": [
        {
          "id": "12a-1",
          "type": "gap-fill",
          "instruction": "Complete with who, which or where.",
          "items": [
            {
              "text": "A vet is a person ___ looks after sick animals.",
              "answers": [
                "who",
                "that"
              ]
            },
            {
              "text": "A library is a place ___ you can borrow books.",
              "answers": [
                "where"
              ]
            },
            {
              "text": "A corkscrew is a thing ___ you use to open wine.",
              "answers": [
                "which",
                "that"
              ]
            },
            {
              "text": "That's the hotel ___ we stayed last year.",
              "answers": [
                "where"
              ]
            }
          ]
        },
        {
          "id": "12a-2",
          "type": "transform",
          "instruction": "Join the sentences with who, which or where.",
          "items": [
            {
              "prompt": "That's the man. He stole my bag.",
              "answers": [
                "That's the man who stole my bag.",
                "That's the man that stole my bag."
              ]
            },
            {
              "prompt": "This is the restaurant. We had our first date there.",
              "answers": [
                "This is the restaurant where we had our first date."
              ]
            },
            {
              "prompt": "I lost the ring. My grandmother gave it to me.",
              "answers": [
                "I lost the ring which my grandmother gave me.",
                "I lost the ring that my grandmother gave me.",
                "I lost the ring my grandmother gave me.",
                "I lost the ring which my grandmother gave to me."
              ]
            }
          ]
        },
        {
