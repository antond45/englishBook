    "9C": {
      "theory": [
        {
          "title": "might / might not",
          "text": "might + инфинитив — «может быть», возможность (примерно 50%). Синоним: may. В отличие от will — нет уверенности.",
          "examples": [
            {
              "en": "Take an umbrella. It might rain.",
              "ru": "Возьми зонт. Может пойти дождь."
            },
            {
              "en": "I might not come to the party — I'm very tired.",
              "ru": "Я, возможно, не приду."
            },
            {
              "en": "She might be at home. Try calling her.",
              "ru": "Может быть, она дома."
            }
          ],
          "tip": "Не путай: maybe (наречие, в начале) и might (глагол): Maybe I'll go = I might go."
        },
        {
          "title": "Словообразование: существительные",
          "table": {
            "head": [
              "Суффикс",
              "Примеры"
            ],
            "rows": [
              [
                "-ment",
                "improve → improvement, agree → agreement"
              ],
              [
                "-tion / -sion",
                "decide → decision, educate → education"
              ],
              [
                "-ness",
                "happy → happiness, kind → kindness"
              ],
              [
                "-ity",
                "possible → possibility, popular → popularity"
              ]
            ]
          }
        }
      ],
