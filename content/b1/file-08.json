    "8A": {
      "theory": [
        {
          "title": "Second Conditional",
          "text": "Нереальная или маловероятная ситуация в настоящем/будущем: if + Past Simple, would + инфинитив.",
          "examples": [
            {
              "en": "If I had more money, I'd travel the world.",
              "ru": "Если бы у меня было больше денег, я бы путешествовал по миру."
            },
            {
              "en": "What would you do if you saw a snake?",
              "ru": "Что бы ты сделал, если бы увидел змею?"
            },
            {
              "en": "If I were you, I'd accept the offer.",
              "ru": "На твоём месте я бы согласился."
            }
          ],
          "tip": "Сравни: If I win the lottery… (реально возможно — First) / If I won the lottery… (мечта — Second). If I were you — устойчивая фраза для совета."
        },
        {
          "title": "Животные и фобии",
          "text": "a spider, a snake, a bee, a wasp, a mosquito, a bat, a rat, a shark, a jellyfish; be scared of, be afraid of, be terrified of, a phobia."
        }
      ],
