    "8C": {
      "theory": [
        {
          "title": "Present Perfect или Past Simple: биографии",
          "text": "О жизни человека, который жив и продолжает действовать — Present Perfect (результат на сегодня). О законченных периодах и умерших людях — Past Simple.",
          "examples": [
            {
              "en": "She has written five novels. (она жива, может написать ещё)",
              "ru": ""
            },
            {
              "en": "Tolstoy wrote many novels. (жизнь закончена)",
              "ru": ""
            },
            {
              "en": "I've worked here since 2020. Before that I worked in a bank for five years.",
              "ru": "Сейчас vs законченный период"
            }
          ]
        },
        {
          "title": "Биография",
          "text": "be born, grow up, go to school / university, graduate, get a job, get married, have children, retire, die; achieve, award, career, success."
        }
      ],
