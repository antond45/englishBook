    "8B": {
      "theory": [
        {
          "title": "Present Perfect + for / since",
          "text": "Действие или состояние началось в прошлом и продолжается сейчас. По-русски — настоящее время («живу 5 лет»), по-английски — Present Perfect.",
          "table": {
            "head": [
              "",
              "Значение",
              "Примеры"
            ],
            "rows": [
              [
                "for",
                "период",
                "for two years, for ages, for a long time"
              ],
              [
                "since",
                "начальная точка",
                "since 2019, since Monday, since I was a child"
              ]
            ]
          },
          "examples": [
            {
              "en": "How long have you lived here? — I've lived here for ten years.",
              "ru": "Сколько ты здесь живёшь? — Десять лет."
            }
          ],
          "tip": "Ошибка русскоязычных: I live here for 10 years. Правильно: I've lived here for 10 years."
        },
        {
          "title": "Страх",
          "text": "scared, frightened, terrified, nervous, worried, panic, a nightmare, scream, shake, sweat."
        }
      ],
