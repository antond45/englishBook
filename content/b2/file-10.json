        {
          "id": "10a-r",
          "type": "reading",
          "instruction": "Read and answer.",
          "title": "The placebo effect",
          "text": "In a famous series of experiments, patients were divided into two groups. Both groups were told they were receiving a new painkiller, but only one group actually got the drug. The other received sugar pills. Surprisingly, many people in both groups reported less pain. This is the 'placebo effect'. Few scientists doubt it exists, but none can fully explain it. Interestingly, placebos seem to work even when patients know they're taking one — as long as they're given by a caring doctor.",
          "questions": [
            {
              "kind": "choice",
              "question": "The second group received…",
              "options": [
                "a stronger drug",
                "sugar pills",
                "nothing"
              ],
              "answer": 1
            },
            {
              "kind": "tf",
              "statement": "People in both groups reported less pain.",
              "answer": true
            },
            {
              "kind": "tf",
              "statement": "Scientists can fully explain the placebo effect.",
              "answer": false
            },
            {
              "kind": "gap",
              "text": "Placebos work best when given by a caring ___.",
              "answers": [
                "doctor"
              ]
            }
          ],
          "image": "💊"
        },
        {
          "id": "10a-l",
          "type": "listening",
          "instruction": "Listen and answer.",
          "title": "A science podcast",
          "script": [
