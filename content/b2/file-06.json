      "theory": [
        {
          "title": "used to / be used to / get used to",
          "table": {
            "head": [
              "Структура",
              "Значение",
              "Пример"
            ],
            "rows": [
              [
                "used to + V",
                "раньше (привычка в прошлом)",
                "I used to sleep eight hours a night."
              ],
              [
                "be used to + -ing / сущ.",
                "быть привыкшим",
                "I'm used to getting up early."
              ],
              [
                "get used to + -ing / сущ.",
                "привыкать",
                "I'm getting used to working nights."
              ]
            ]
          },
          "tip": "После be/get used to — -ing или существительное (to здесь предлог): I'm used to it / to driving on the left. Не I'm used to drive."
        },
        {
          "title": "Сон",
          "text": "fall asleep, be fast asleep, oversleep, have a nap, snore, sleepwalk, insomnia, a nightmare, be a light/heavy sleeper, toss and turn, set the alarm."
