    "7A": {
      "theory": [
        {
          "title": "Модальные глаголы о прошлом",
          "table": {
            "head": [
              "Форма",
              "Значение",
              "Пример"
            ],
            "rows": [
              [
                "must have + V3",
                "наверняка (уверенный вывод)",
                "The streets are wet. It must have rained."
              ],
              [
                "might / may / could have + V3",
                "возможно",
                "She might have missed the bus."
              ],
              [
                "can't / couldn't have + V3",
                "не может быть",
                "He can't have seen me — he didn't say hello."
              ],
              [
                "should have + V3",
                "следовало (но не сделал)",
                "You should have told me!"
              ],
              [
                "shouldn't have + V3",
                "не следовало (но сделал)",
                "I shouldn't have eaten so much."
              ],
              [
                "needn't have + V3",
                "не нужно было (но сделал)",
                "You needn't have brought a gift."
              ]
            ]
          },
          "tip": "В речи have звучит слабо: must've /ˈmʌstəv/, should've, could've. Писать must of — ошибка!"
        },
        {
          "title": "Глаголы, которые путают",
          "text": "remind (напомнить) / remember; prevent (предотвратить) / avoid (избегать); rob (ограбить кого-то) / steal (украсть что-то); raise (поднимать что-то) / rise (подниматься); lie (лежать) / lay (класть); argue / discuss."
        }
      ],
      "videos": [
        {
          "title": "Past modals of deduction",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=must+have+might+have+can't+have+past+modals"
        }
      ],
