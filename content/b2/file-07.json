        {
          "id": "7a-r",
          "type": "reading",
          "instruction": "Read and answer.",
          "title": "The mystery of the Mary Celeste",
          "text": "In 1872 the ship Mary Celeste was found floating in the Atlantic with nobody on board. The cargo was untouched, there was food for six months, and the crew's belongings were still there. One lifeboat was missing. What could have happened? Pirates can't have attacked — nothing was stolen. Some historians think the captain might have feared that the cargo of alcohol was about to explode and ordered everyone into the lifeboat. If so, they must have been lost at sea.",
          "questions": [
            {
              "kind": "gap",
              "text": "The ship was found in ___.",
              "answers": [
                "1872"
              ]
            },
            {
              "kind": "tf",
              "statement": "The cargo had been stolen.",
              "answer": false
            },
            {
              "kind": "choice",
              "question": "One theory is that the captain feared…",
              "options": [
                "pirates",
                "an explosion",
                "a storm"
              ],
              "answer": 1
            }
          ],
          "image": "🚢"
        },
        {
