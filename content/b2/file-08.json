    "8B": {
      "theory": [
        {
          "title": "Глаголы косвенной речи",
          "table": {
            "head": [
              "Структура",
              "Глаголы",
              "Пример"
            ],
            "rows": [
              [
                "+ to + V",
                "agree, offer, promise, refuse, threaten",
                "He promised to call."
              ],
              [
                "+ sb + to + V",
                "advise, ask, convince, encourage, invite, remind, tell, warn",
                "She warned me not to go."
              ],
              [
                "+ -ing",
                "admit, deny, recommend, suggest",
                "He denied taking the money."
              ],
              [
                "+ предлог + -ing",
                "apologise for, accuse sb of, insist on, blame sb for",
                "She apologised for being late."
              ]
            ]
          },
          "tip": "suggest НЕ используется с инфинитивом: He suggested going (или suggested that we go), а не suggested us to go."
        },
        {
          "title": "Медиа",
          "text": "a headline, a journalist, a reporter, a correspondent, a critic, the press, a tabloid, a broadsheet, clickbait, biased, sensational, accurate, a podcast, a feed."
        }
      ],
