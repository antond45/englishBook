    "8A": {
      "theory": [
        {
          "title": "Пассив во всех временах",
          "table": {
            "head": [
              "Время",
              "Пример"
            ],
            "rows": [
              [
                "Present Continuous",
                "The suspect is being questioned."
              ],
              [
                "Present Perfect",
                "Two men have been arrested."
              ],
              [
                "Past Perfect",
                "The car had been stolen before the robbery."
              ],
              [
                "Future / modal",
                "He will be sentenced tomorrow. It must be done."
              ],
              [
                "Infinitive / gerund",
                "He hopes to be released. She hates being photographed."
              ]
            ]
          }
        },
        {
          "title": "It is said that… / He is thought to…",
          "text": "Безличные конструкции для слухов и новостей (по-русски «говорят, что…», «считается, что…»): say, believe, think, report, expect, know.",
          "examples": [
            {
              "en": "It is believed that the thief was a former employee.",
              "ru": "Считается, что вор — бывший сотрудник."
            },
            {
              "en": "The thief is believed to be a former employee.",
              "ru": "То же, через личную форму."
            },
            {
              "en": "He is said to have escaped to Spain.",
              "ru": "Говорят, что он сбежал в Испанию (в прошлом → to have + V3)."
            }
          ]
        },
        {
          "title": "Преступление и наказание",
          "text": "commit a crime, be charged with, be accused of, plead guilty, a trial, a jury, a verdict, be sentenced to, be acquitted, a fine, community service, life imprisonment."
        }
      ],
