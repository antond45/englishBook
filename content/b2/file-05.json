        {
          "id": "5a-r",
          "type": "reading",
          "instruction": "Read and answer.",
          "title": "Sliding doors",
          "text": "In 1999 Anna was offered two jobs: one in Moscow, one in a small town by the sea. She chose Moscow. 'If I'd gone to the coast, I would never have met my husband,' she says. 'And if I hadn't met him, I wouldn't have my two children.' Psychologists call this 'counterfactual thinking' — imagining how life could have been different. It can cause regret, but it can also make us more grateful for what we have.",
          "questions": [
            {
              "kind": "gap",
              "text": "Anna was offered two jobs in ___.",
              "answers": [
                "1999"
              ]
            },
            {
              "kind": "choice",
              "question": "Which job did she choose?",
              "options": [
                "by the sea",
                "in Moscow",
                "neither"
              ],
              "answer": 1
            },
            {
              "kind": "tf",
              "statement": "Counterfactual thinking can make us more grateful.",
              "answer": true
            }
          ],
          "image": "🚪"
        },
        {
          "id": "5a-l",
          "type": "listening",
          "instruction": "Listen and answer.",
