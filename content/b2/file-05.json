    "5B": {
      "theory": [
        {
          "title": "wish / if only",
          "table": {
            "head": [
              "Структура",
              "О чём жалеем",
              "Пример"
            ],
            "rows": [
              [
                "wish + Past Simple",
                "настоящее",
                "I wish I had more free time. (но у меня нет)"
              ],
              [
                "wish + Past Perfect",
                "прошлое",
                "I wish I hadn't said that. (но я сказал)"
              ],
              [
                "wish + would",
                "раздражение чужим поведением",
                "I wish you would stop interrupting!"
              ],
              [
                "wish + could",
                "неспособность",
                "I wish I could speak French."
              ]
            ]
          },
          "tip": "If only… — более эмоциональный вариант: If only I'd listened to you! О себе wish + would не используем: I wish I would… — неправильно."
        },
        {
          "title": "Выражения с go",
          "text": "go wrong, go missing, go deaf, go grey, go bankrupt, go viral, go ahead, go out of business, go on (продолжать)."
        }
