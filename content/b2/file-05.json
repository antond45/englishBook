  "lessons": {
    "5A": {
      "theory": [
        {
          "title": "Нереальные условия: 2-й и 3-й тип",
          "table": {
            "head": [
              "Тип",
              "Схема",
              "Значение",
              "Пример"
            ],
            "rows": [
              [
                "Second",
                "if + Past, would + V",
                "нереально сейчас",
                "If I had more time, I'd learn Chinese."
              ],
              [
                "Third",
                "if + Past Perfect, would have + V3",
                "нереально в прошлом (сожаление)",
                "If I'd left earlier, I wouldn't have missed the train."
              ],
              [
                "Mixed",
                "if + Past Perfect, would + V",
                "прошлое → результат сейчас",
                "If I'd studied medicine, I'd be a doctor now."
              ]
            ]
          },
          "tip": "'d может быть had или would: If I'd known (= had), I'd have come (= would)."
        },
        {
          "title": "Чувства",
          "text": "devastated, thrilled, delighted, furious, exhausted, astonished, terrified, relieved, upset, disappointed, grateful. Сильные прилагательные (devastated, thrilled) не сочетаются с very — только с absolutely: absolutely furious."
        }
      ],
      "videos": [
        {
          "title": "Third conditional",
          "kind": "youtube-search",
          "url": "https://www.youtube.com/results?search_query=third+conditional+mixed+conditional+upper+intermediate"
        }
      ],
